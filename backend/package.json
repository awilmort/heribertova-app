{
  "name": "@heribertova/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts | pino-pretty",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "s3:check": "tsx --env-file-if-exists=.env scripts/s3-check.ts",
    "voters:import": "tsx --max-old-space-size=160 --env-file-if-exists=.env scripts/voters-import.ts",
    "voters:fake": "tsx scripts/fake-voter-file.ts",
    "superadmin:create": "tsx --env-file-if-exists=.env scripts/create-superadmin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@heribertova/shared": "workspace:*",
    "@inquirer/confirm": "^6.3.2",
    "@inquirer/input": "^5.1.6",
    "@inquirer/password": "^5.2.2",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.2",
    "otpauth": "^9.5.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "stream-json": "^3.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
