# Local development values. Copy to backend/.env (gitignored): `cp backend/.env.example backend/.env`.
# Production values live only in Render's environment (HERIBERTO_ARCHITECTURE.md Appendix A.3).
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Local MongoDB from docker-compose.dev.yml (single-node replica set).
MONGODB_URI=mongodb://localhost:27017/heribertova?replicaSet=rs0&directConnection=true
# Number of reverse proxies in front of the API (0 locally; set in production, see plan 10.1).
TRUST_PROXY=0
# Global per-IP limit: max requests per window.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000
# Login attempts per client IP + cédula per 15 minutes (the account lockout applies on top).
LOGIN_RATE_LIMIT_MAX=10
VOTER_LOOKUP_DAILY_QUOTA=300
# The web app's origin: the only Origin accepted on POST/PUT/PATCH/DELETE (CSRF guard).
# Locally the browser talks to Next on :3000, which forwards /api to this API.
APP_ORIGIN=http://localhost:3000

# Object storage: the local S3 emulator from docker-compose.dev.yml (its local-only root credentials).
# In production leave S3_ENDPOINT unset and S3_FORCE_PATH_STYLE=false so the SDK talks to AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=heribertova
AWS_SECRET_ACCESS_KEY=heribertova-local-secret
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_MEDIA_BUCKET=media
S3_IMPORTS_BUCKET=imports

# Cloudflare Turnstile public test secret: every token passes (login).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Encrypts the superadmin's TOTP secret at rest (AES-256-GCM): 32 random bytes, base64.
# This value is for local development only; production gets its own: `openssl rand -base64 32`.
TOTP_ENC_KEY=6JH5JpPNog/Cnpm0lP/LDXmi/PVMFJmTPcVKTjGLxRs=
